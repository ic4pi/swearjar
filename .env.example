# Backend Environment Variables (.env in backend folder)
NODE_ENV=production
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production  # required, no fallback
STRIPE_SECRET_KEY=sk_test_...  # Get from Stripe dashboard, required
STRIPE_WEBHOOK_SECRET=whsec_...  # Get from Stripe webhook setup
ADMIN_DEFAULT_PASSWORD=  # optional: set the initial admin password. If unset, a random one is generated and printed to the server log on first run.
FRONTEND_URL=https://your-frontend.vercel.app  # comma-separated for multiple origins, used for CORS in production

# Frontend Environment Variables (.env in project root)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...  # Get from Stripe dashboard
VITE_API_URL=https://your-backend-url.onrender.com/api
